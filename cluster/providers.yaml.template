# providers.yaml.template
#
# Sophia's provider-pool configuration. Sophia reads this file on
# startup (via the SOPHIA_PROVIDER_POOL env var) and uses it to
# configure ladyol's ProviderPool — the rotating account pool that
# fronts /v1/chat/completions.
#
# The schema is ladyol's `providers.yaml` (a superset of OpenAI's
# provider-list format). The bundled reference is in ladyol's
# installation at:
#   /usr/local/lib/python3.12/site-packages/ladyol/_data_/providers.yaml
# (in the sophia image) — every key we use below comes from there.
#
# This template is what's pushed to sophia.git. After you fill in your
# real provider/accounts, the cluster harness copies it into the
# image at /etc/sophia/providers.yaml and sets SOPHIA_PROVIDER_POOL
# to point at it. Sophia + Open WebUI then route every chat
# completion through the configured pool.
#
# ────────────────────────────────────────────────────────────────────
# Template
# ────────────────────────────────────────────────────────────────────

ProviderPool:
  strategies:
    model-provider-selection:
      - round_robin
      - round_robin_weighted
      - random
      - weighted
      - cheapest
      - cheapest_weighted
      - least_used
      - least_used_weighted
      - least_used_cheapest
      - least_used_cheapest_weighted
      - best_available
    task_router:
      tasks:
        "default":  "<default-model-id>"
        "implement": "<default-model-id>"
        "analyze":  "<default-model-id>"

  providers:
    # ──── Local providers (no API key needed) ────────────────────────
    ollama:
      name: "ollama"
      display_name: "Local Ollama"
      env_key: ""
      is_gateway: False
      is_local: True
      base_url: "http://host.docker.internal:11434/v1"
      skip_prefixes: []
      supports_prompt_caching: False
      models:
        llama3:
          enabled: True
          capability_score: 8
          capabilities: [chat, analysis, code]
          max_tokens: 8192
        mistral:
          enabled: True
          capability_score: 7
          capabilities: [chat, code]
          max_tokens: 8192

    # ──── Cloud providers ───────────────────────────────────────────
    # Copy this template block for each provider you want to enable.
    # Fill in `enabled: True` on the model you actually have a key for.
    #
    # anthropic:
    #   name: "anthropic"
    #   display_name: "Anthropic Claude"
    #   env_key: "ANTHROPIC_API_KEY"          # name of the env Sophia reads from PyKeyStore
    #   is_gateway: True
    #   is_local: False
    #   supports_prompt_caching: True
    #   base_url: "https://api.anthropic.com/v1"
