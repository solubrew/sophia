# Sophia cluster env — copy to `.env` and adjust.

# === Sophia requestor API key ===
# After the first `./cluster/docker-compose up -d --build`, create one:
#   ./cluster/docker-compose exec -T sophia \
#     python -m sophia.cmds.manage_keys create open-webui
# Paste the printed key here so Open WebUI can authenticate.
# Until that runs, leave the placeholder below (compose will refuse to
# start Open WebUI without a real key).
SOPHIA_REQUESTOR_KEY=sk-sophia-CHANGE-ME-AFTER-FIRST-RUN
