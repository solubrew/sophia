# Docker Compose deployment for Sophia — copy to .env and adjust.

# LAN bind (matches the MVP).
SOPHIA_HOST=0.0.0.0
SOPHIA_PORT=8765

# PyKeyStore locations.
# Inside the container, the vault file lives under a named volume
# mounted at /var/lib/sophia/pycurity/. The host path here only
# matters for the init/bootstrap step that creates the vault.
SOPHIA_PYCURITY_DB_PATH=/var/lib/sophia/pycurity/vault.db
SOPHIA_PYCURITY_SALT_PATH=/var/lib/sophia/pycurity/salt.bin

# Single-unlock pattern: at deploy time, the operator pulls this from
# the main PyKeyStore instance (service name
# `sophia_cluster_master_passphrase` — pattern `<cluster_name>_cluster_master_passphrase`)
# and exports it. The container uses it to unlock the internal vault.
# NEVER commit this value.
SOPHIA_MASTER_PASSPHRASE=replace-me-with-main-vault-sophia_cluster_master_passphrase

# Provider pool YAML — defaults to ladyol's bundled file. Override to
# point at a customised providers.yaml mounted into the container.
SOPHIA_PROVIDER_POOL=

# Logging
SOPHIA_LOG_LEVEL=INFO

# Secrets resolution. 1 = allow env-var fallback (dev).
# 0 = PyKeyStore-only (production). Missing secrets cause hard
# ValueError at startup, not silent fallback to empty strings.
SOPHIA_ALLOW_ENV_FALLBACK=1

# Optional Caddy reverse proxy — only set if you're fronting Sophia
# with TLS (Cloudflare DNS-01 or HTTP-01 ACME challenge).
DOMAIN=
CADDY_CHALLENGE=http
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=
